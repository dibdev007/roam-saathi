// Roam Saathi — Prisma schema (PostgreSQL).
// Use this schema with Neon, Supabase, Prisma Postgres or any hosted PostgreSQL.
// Models are identical to schema.prisma — only the datasource provider changes.
// Full instructions: DATABASE_SETUP.md
//
//   npx prisma generate --schema prisma/schema.postgres.prisma
//   npx prisma db push   --schema prisma/schema.postgres.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id                 String   @id @default(cuid())
  name               String // e.g. "Mahindra Thar 4x4"
  brand              String? // e.g. "Mahindra"
  class              String // SUV | HATCHBACK | SEDAN | SCOOTER | BIKE | VAN
  seats              Int
  transmission       String   @default("Manual") // Manual | Automatic
  fuelType           String   @default("Petrol") // Petrol | Diesel | Electric

  // ---- Pricing (all INR, all editable from the admin panel) ----
  dailyRate          Int // Self-drive price per day
  withDriverPerDay   Int? // Chauffeur-driven price per day (null = not offered)
  withDriverAvailable Boolean @default(true)
  monthlyRate        Int? // Optional long-term monthly rate
  kmLimitPerDay      Int? // Included km per day (null = unlimited)
  extraKmRate        Int? // Rs per extra km
  securityDeposit    Int? // Refundable deposit for self-drive
  driverBata         Int? // Optional driver charge per day (bata)

  // ---- Fuel & running (v3) ----
  mileageKmpl        Int? // Approx km per litre — powers the fuel estimator
  fuelNote           String? // Optional per-vehicle fuel/toll note shown on the card

  // ---- Identity / ops ----
  registrationNumber String?
  imageUrl           String?
  features           String? // Comma-separated: "AC, Bluetooth, Roof rails"
  description        String   @default("")

  // ---- Display controls ----
  available          Boolean  @default(true) // Bookable right now
  popular            Boolean  @default(false) // Show on the homepage fleet section
  sortOrder          Int      @default(0) // Lower = shown first

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Booking {
  id             String   @id @default(cuid())
  name           String
  phone          String
  pickupType     String // Airport counter | Hotel delivery | Other
  pickupLocation String?
  pickupDate     DateTime
  returnDate     DateTime
  vehicleClass   String
  vehicleName    String? // Specific vehicle once confirmed
  destination    String? // Where the customer plans to go
  withDriver     Boolean  @default(false)
  estimatedTotal Int? // Rough quote in INR
  message        String?
  status         String   @default("New") // New | Contacted | Confirmed | Ongoing | Completed | Cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ---- v3: No-code page builder (blogs, travel diaries, customer stories,
//      policies — anything the owner wants to publish without code) ----
model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique // /p/<slug>
  type           String   @default("custom") // blog | travel-diary | customer-story | policy | guide | custom
  parentId       String? // sub-pages live under a parent page
  excerpt        String   @default("")
  coverImage     String?
  blocks         String   @default("[]") // JSON array of content blocks
  visibleOnHome  Boolean  @default(false) // show a card in the homepage Stories & Guides section
  showInMenu     Boolean  @default(false) // list in the website menu / footer
  published      Boolean  @default(false)
  sortOrder      Int      @default(0)
  seoTitle       String? // v4: custom SEO/browser tab title for this page
  seoDescription String?
  seoKeywords    String? // v4: comma-separated keywords for this page
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---- v4: Stays & Partners (hotel directory) --------------------------
// Identical to schema.prisma — see that file for full comments.
model Hotel {
  id          String   @id @default(cuid())
  name        String
  state       String   @default("Assam")
  city        String
  area        String? // locality / landmark
  phone       String // booking phone shown on the card
  whatsapp    String? // optional direct WhatsApp (digits only)
  priceFrom   Int? // starting price per night (INR)
  category    String   @default("Standard") // Budget | Standard | Premium | Resort | Homestay
  description String   @default("")
  amenities   String? // comma-separated: "WiFi, Parking, Restaurant"
  images      String   @default("[]") // JSON array of image URLs / data URLs
  bookingUrl  String? // optional external booking link
  mapUrl      String? // optional Google Maps link
  partner     Boolean  @default(false) // official Roam Saathi collaboration
  featured    Boolean  @default(false) // show in the homepage Stays preview
  showOnSite  Boolean  @default(true) // visible in /stays
  sortOrder   Int      @default(0) // lower = first
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
