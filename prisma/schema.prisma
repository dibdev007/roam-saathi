// Roam Saathi — Prisma schema (PostgreSQL).
// This project deploys with a cloud Postgres database (Neon / Supabase /
// Prisma Postgres) set via the DATABASE_URL environment variable.
// A SQLite copy for offline experiments: prisma/schema.sqlite.prisma
// Full setup guide: DATABASE_SETUP.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id                  String   @id @default(cuid())
  name                String
  brand               String?
  class               String
  seats               Int
  transmission        String   @default("Manual")
  fuelType            String   @default("Petrol")

  dailyRate           Int
  withDriverPerDay    Int?
  withDriverAvailable Boolean  @default(true)
  monthlyRate         Int?
  kmLimitPerDay       Int?
  extraKmRate         Int?
  securityDeposit     Int?
  driverBata          Int?

  registrationNumber  String?
  imageUrl            String?
  features            String?
  description         String   @default("")

  available           Boolean  @default(true)
  popular             Boolean  @default(false)
  sortOrder           Int      @default(0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Booking {
  id             String   @id @default(cuid())
  name           String
  phone          String
  pickupType     String
  pickupLocation String?
  pickupDate     DateTime
  returnDate     DateTime
  vehicleClass   String
  vehicleName    String?
  destination    String?
  withDriver     Boolean  @default(false)
  estimatedTotal Int?
  message        String?
  status         String   @default("New")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
