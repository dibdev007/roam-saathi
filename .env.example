# Roam Saathi v4 — environment variables
# Copy this file to ".env" for local development.
# On Vercel you do NOT need a .env file — set these in
# Project -> Settings -> Environment Variables instead.

# Cloud Postgres connection string (Neon / Supabase / Prisma Postgres).
# Neon example (use the POOLED string from the Neon dashboard):
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: passcode that protects the one-time /api/setup endpoint.
# Defaults to roam2024 if not set. Use your current admin password.
ADMIN_SETUP_KEY=roam2024

# Optional but recommended: any long random string. This is the secret key
# that signs the admin login session cookie. If you leave it out, a default
# is used — fine to start, better to change it once.
ADMIN_SECRET=change-me-to-a-long-random-string
