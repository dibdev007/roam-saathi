# Roam Saathi v6 — environment variables
# On Vercel you do NOT need a .env file — set these in
# Project -> Settings -> Environment Variables instead.

# REQUIRED IN PRODUCTION — free cloud Postgres (Neon / Supabase / Prisma Postgres).
# Neon example (use the POOLED string from the Neon dashboard):
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# OPTIONAL — override the secret that signs admin session cookies.
# When unset, a random secret is generated and stored safely in your
# database automatically (nothing sensitive lives in the code).
# Set ONLY for manual control; use 32+ random characters.
ADMIN_SECRET=

# OPTIONAL — enables the manual provisioning endpoint POST /api/setup.
# While unset the endpoint is completely disabled (answers 404).
# Use 20+ random characters; NEVER reuse your admin password.
ADMIN_SETUP_KEY=
