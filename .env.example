# Roam Saathi v6 — environment variables
# Copy this file to ".env" for local development.
# On Vercel you do NOT need a .env file — set these in
# Project -> Settings -> Environment Variables instead.

# Cloud Postgres connection string (Neon / Supabase / Prisma Postgres).
# Neon example (use the POOLED string from the Neon dashboard):
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# RECOMMENDED: any long random string. This is the secret key that signs
# the admin login session cookie. If you leave it out a built-in default
# is used — fine to start, much better to set your own.
ADMIN_SECRET=change-me-to-a-long-random-string

# OPTIONAL: key-based access to the /api/setup repair endpoint.
# v6 change: there is NO default any more — with this variable unset the
# endpoint answers 403 to every key. The admin portal's Database tab can
# always run the same repair with the admin login (no key needed).
ADMIN_SETUP_KEY=

# OPTIONAL: allows embedding the site in third-party frames. Leave unset.
# FRAME_ANCESTORS=
